/target/
*.exe
/.cache/

# Self-contained Rust toolchain (rustup + cargo home). Machine-local and large:
# never committed. See scripts/env.sh for how it is activated.
/.toolchain/

# The YAML spike is its own workspace; its build products are not the project's.
/spikes/*/target/
/spikes/*/Cargo.lock

# The mock package's build products. The wasm module is rebuilt by
# scripts/build-mock-package.ps1 and shipped as a release asset: a binary in the
# repository drifts from the source that should have rebuilt it, which is exactly how
# a stale o824.exe once turned eight green golden files red.
/packages/o824-mock/o824-mock.wasm
/packages/o824-mock/transcripts/
/dist/

# The SDK compiles from TypeScript: dist/ is a build product, rebuilt by `npm run
# build` and by CI, never committed.
/packages/o824-sdk/dist/
/packages/o824-sdk/node_modules/

# The GUI has its own workspace and its own target directory.
apps/o824-gui/target/
apps/o824-gui/gen/
o824-gui.log
apps/o824-gui/*.png
apps/o824-gui/shot*.png
.ci-manifest
.ci-other.hex
test-output.txt
sdk-test.txt
dist/

# The window's frontend is source that happens to live in a folder called `dist`: it is
# edited by hand and embedded by tauri-build. The generic rule above would hide every new
# asset from `git add`, so the window's folder is re-included on purpose.
!/apps/o824-gui/dist/
!/apps/o824-gui/dist/**

# The release signing key must never reach the repository. Ignoring it by name is a safety net
# for the one mistake that cannot be undone: a published private key signs anything.
release.key
*.key
